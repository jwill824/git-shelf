#!/usr/bin/env zsh
# Dispatcher: Route git cloak commands to lib/cmd-<cmd>.sh implementations

set -e

_GIT_CLOAK_DIR="$(cd "$(dirname "$0")/.." && pwd)"
_COMMAND="${1:-help}"

# Source common utilities
source "$_GIT_CLOAK_DIR/lib/common.sh"

# Load and execute command
_CMD_FILE="$_GIT_CLOAK_DIR/lib/cmd-${_COMMAND}.sh"
if [[ ! -f "$_CMD_FILE" ]]; then
    echo "Error: Unknown command '$_COMMAND'" >&2
    echo "Available commands: init, hide, watch, unwatch, list, switch, refresh, merge-main, sync, monitor" >&2
    exit 1
fi

source "$_CMD_FILE"

# Call command function with remaining args
# Convert hyphens to underscores for function naming
_FUNC_NAME="cmd_${_COMMAND//-/_}"
"$_FUNC_NAME" "${@:2}"
